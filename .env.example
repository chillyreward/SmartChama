# Copy this file to .env.local 
# and fill in real values
# NEVER commit .env.local to GitHub

# ── Supabase ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL ───────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.vercel.app

# ── M-Pesa Daraja API ─────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORT_CODE=your-short-code
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# ── Africa's Talking ──────────────
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=SmartChama

# ── Blockchain ────────────────────
BLOCKCHAIN_PRIVATE_KEY=your-private-key
BLOCKCHAIN_RPC_URL=your-rpc-url

# ── Security secrets (generate each with: openssl rand -hex 32) ──
# Shared by API routes that call each other (USSD → STK push, loans → SMS, ...)
INTERNAL_API_SECRET=
# Vercel sends this as "Authorization: Bearer ..." to cron routes
CRON_SECRET=
# Appended to the M-Pesa callback URL as ?secret=...
MPESA_CALLBACK_SECRET=
# Register the Africa's Talking USSD callback as /api/ussd?secret=...
USSD_WEBHOOK_SECRET=
# Mixed into stored OTP hashes
OTP_PEPPER=
