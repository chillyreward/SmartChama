# Copy this file to .env.local 
# and fill in real values
# NEVER commit .env.local to GitHub

# ── Supabase ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URL ───────────────────────
# The address people use. Both are read; set them to the same value.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# Shown on the contact, privacy and terms pages, and used as the email reply-to
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain
NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.vercel.app

# ── M-Pesa Daraja API ─────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORT_CODE=your-short-code
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# ── Email (Resend: resend.com, free for 100 emails a day) ──
# Payment confirmations, invites and new-group codes. Without a key, emails are skipped.
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. Akibora <hello@mail.akibora.co.ke>
EMAIL_FROM=

# ── SMS: Wakali (used first when set) or Africa's Talking ──
WAKALI_API_KEY=

# ── Africa's Talking ──────────────
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=Akibora

# ── Blockchain ────────────────────
BLOCKCHAIN_PRIVATE_KEY=your-private-key
BLOCKCHAIN_RPC_URL=your-rpc-url

# ── Security secrets (generate each with: openssl rand -hex 32) ──
# Shared by API routes that call each other (USSD → STK push, outbox → SMS, ...)
INTERNAL_API_SECRET=
# Vercel sends this as "Authorization: Bearer ..." to cron routes
CRON_SECRET=
# Appended to the M-Pesa callback URL as ?secret=...
MPESA_CALLBACK_SECRET=
# Register the Africa's Talking USSD callback as /api/ussd?secret=...
USSD_WEBHOOK_SECRET=
# Mixed into stored OTP hashes
OTP_PEPPER=

# ── Identity verification (face comparison) ──
# AWS IAM user with only rekognition:CompareFaces and rekognition:DetectFaces.
# Leave empty to send every submission to staff review (/staff/kyc-review).
REKOGNITION_REGION=
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
